Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Value: true
    - Class: rviz_default_plugins/RobotModel
      Name: RobotModel
      Alpha: 0.6
      Description Source: Topic
      Description Topic:
        Depth: 5
        Durability Policy: Transient Local
        Reliability Policy: Reliable
        Value: /robot_description
      Value: true
    - Class: rviz_default_plugins/TF
      Name: TF (all frames)
      Enabled: true
      Frame Timeout: 1000
      Frames:
        All Enabled: true
      Marker Scale: 0.15
      Show Arrows: false
      Show Axes: true
      Show Names: true
      Value: true
    - Class: rviz_default_plugins/Axes
      Name: Camera frame (arm_a_camera_optical_frame)
      Reference Frame: arm_a_camera_optical_frame
      Length: 0.08
      Radius: 0.006
      Value: true
    - Class: rviz_default_plugins/Axes
      Name: ArUco tag frame (aruco_tag)
      Reference Frame: aruco_tag
      Length: 0.08
      Radius: 0.006
      Value: true
    - Class: rviz_default_plugins/Image
      Name: Camera (ArUco detection)
      Normalize Range: true
      Topic:
        Depth: 2
        Durability Policy: Volatile
        Reliability Policy: Reliable
        Value: /arm_a/camera/aruco_debug
      Value: true
  Global Options:
    Fixed Frame: world
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 1.0
      Focal Point:
        X: 0.6
        Y: 0.08
        Z: 0.3
      Name: Current View
      Pitch: 0.4
      Target Frame: world
      Yaw: -1.2
Window Geometry:
  Height: 1000
  Width: 1500
