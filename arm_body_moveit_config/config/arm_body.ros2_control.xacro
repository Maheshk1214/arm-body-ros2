<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:macro name="arm_body_ros2_control" params="name initial_positions_file">
    <xacro:property name="initial_positions" value="${xacro.load_yaml(initial_positions_file)['initial_positions']}"/>

    <ros2_control name="${name}" type="system">
      <hardware>
        <!-- Mock hardware for the RViz demo only. Gazebo uses gz_ros2_control from arm_body_description. -->
        <plugin>mock_components/GenericSystem</plugin>
      </hardware>
      <joint name="arm_a_joint1">
        <command_interface name="position"/>
        <state_interface name="position">
          <param name="initial_value">${initial_positions['arm_a_joint1']}</param>
        </state_interface>
        <state_interface name="velocity"/>
      </joint>
      <joint name="arm_a_joint2">
        <command_interface name="position"/>
        <state_interface name="position">
          <param name="initial_value">${initial_positions['arm_a_joint2']}</param>
        </state_interface>
        <state_interface name="velocity"/>
      </joint>
      <joint name="arm_a_joint3">
        <command_interface name="position"/>
        <state_interface name="position">
          <param name="initial_value">${initial_positions['arm_a_joint3']}</param>
        </state_interface>
        <state_interface name="velocity"/>
      </joint>
      <joint name="arm_a_joint4">
        <command_interface name="position"/>
        <state_interface name="position">
          <param name="initial_value">${initial_positions['arm_a_joint4']}</param>
        </state_interface>
        <state_interface name="velocity"/>
      </joint>
      <joint name="arm_a_joint5">
        <command_interface name="position"/>
        <state_interface name="position">
          <param name="initial_value">${initial_positions['arm_a_joint5']}</param>
        </state_interface>
        <state_interface name="velocity"/>
      </joint>
      <joint name="arm_a_joint6">
        <command_interface name="position"/>
        <state_interface name="position">
          <param name="initial_value">${initial_positions['arm_a_joint6']}</param>
        </state_interface>
        <state_interface name="velocity"/>
      </joint>
      <joint name="arm_a_gripper_joint">
        <command_interface name="position"/>
        <state_interface name="position">
          <param name="initial_value">${initial_positions['arm_a_gripper_joint']}</param>
        </state_interface>
        <state_interface name="velocity"/>
      </joint>
      <joint name="arm_b_joint1">
        <command_interface name="position"/>
        <state_interface name="position">
          <param name="initial_value">${initial_positions['arm_b_joint1']}</param>
        </state_interface>
        <state_interface name="velocity"/>
      </joint>
      <joint name="arm_b_joint2">
        <command_interface name="position"/>
        <state_interface name="position">
          <param name="initial_value">${initial_positions['arm_b_joint2']}</param>
        </state_interface>
        <state_interface name="velocity"/>
      </joint>
      <joint name="arm_b_joint3">
        <command_interface name="position"/>
        <state_interface name="position">
          <param name="initial_value">${initial_positions['arm_b_joint3']}</param>
        </state_interface>
        <state_interface name="velocity"/>
      </joint>
      <joint name="arm_b_joint4">
        <command_interface name="position"/>
        <state_interface name="position">
          <param name="initial_value">${initial_positions['arm_b_joint4']}</param>
        </state_interface>
        <state_interface name="velocity"/>
      </joint>
      <joint name="arm_b_joint5">
        <command_interface name="position"/>
        <state_interface name="position">
          <param name="initial_value">${initial_positions['arm_b_joint5']}</param>
        </state_interface>
        <state_interface name="velocity"/>
      </joint>
      <joint name="arm_b_joint6">
        <command_interface name="position"/>
        <state_interface name="position">
          <param name="initial_value">${initial_positions['arm_b_joint6']}</param>
        </state_interface>
        <state_interface name="velocity"/>
      </joint>
      <joint name="arm_b_gripper_joint">
        <command_interface name="position"/>
        <state_interface name="position">
          <param name="initial_value">${initial_positions['arm_b_gripper_joint']}</param>
        </state_interface>
        <state_interface name="velocity"/>
      </joint>
    </ros2_control>
  </xacro:macro>
</robot>
