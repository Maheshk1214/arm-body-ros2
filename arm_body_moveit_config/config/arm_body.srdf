    <disable_collisions link1="arm_a_gripper_2" link2="arm_a_wrist" reason="Never"/>
    <disable_collisions link1="arm_a_merge" link2="arm_a_merge2_1" reason="Never"/>
    <disable_collisions link1="arm_a_merge" link2="arm_a_merge2_2" reason="Never"/>
