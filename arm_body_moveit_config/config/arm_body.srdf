    <disable_collisions link1="arm_a_merge" link2="arm_a_sts3215_3" reason="Never"/>
    <disable_collisions link1="arm_a_merge" link2="arm_a_sts3215_4" reason="Never"/>
    <disable_collisions link1="arm_a_merge" link2="arm_a_sts3215_5" reason="Never"/>
    <disable_collisions link1="arm_a_merge" link2="arm_b_merge" reason="Never"/>
    <disable_collisions link1="arm_a_merge" link2="arm_b_merge2_1" reason="Never"/>
    <disable_collisions link1="arm_a_merge" link2="arm_b_servo_base" reason="Never"/>
    <disable_collisions link1="arm_a_merge" link2="arm_b_sts3250_2" reason="Never"/>
    <disable_collisions link1="arm_a_merge" link2="base_link" reason="Never"/>
    <disable_collisions link1="arm_a_merge2_1" link2="arm_a_merge2_2" reason="Never"/>
    <disable_collisions link1="arm_a_merge2_1" link2="arm_a_merge2_3" reason="Never"/>
    <disable_collisions link1="arm_a_merge2_1" link2="arm_a_servo_base" reason="Never"/>
